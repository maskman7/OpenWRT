#!/bin/sh
# 首次启动生成 aria2 RPC 口令（不把固定口令写进公开固件）。
# 口令写入 /etc/aria2.conf 并另存一份到 /root/aria2_rpc_secret.txt（600），
# 之后 ssh 上去 cat 一下就能拿到，用于 AriaNg 的"密钥"字段。

CONF=/etc/aria2.conf
SECRET_FILE=/root/aria2_rpc_secret.txt

[ -f "$CONF" ] || exit 0

cur=$(sed -n 's/^rpc-secret=//p' "$CONF" 2>/dev/null)
if [ -n "$cur" ]; then
	exit 0
fi

SECRET=$(od -An -tx1 -N 16 /dev/urandom 2>/dev/null | tr -d ' \n')
if [ -z "$SECRET" ]; then
	SECRET=$(tr -dc 'a-f0-9' < /dev/urandom | head -c 32)
fi
[ -n "$SECRET" ] || exit 0

if grep -q '^rpc-secret=' "$CONF"; then
	sed -i "s|^rpc-secret=.*|rpc-secret=$SECRET|" "$CONF"
else
	echo "rpc-secret=$SECRET" >> "$CONF"
fi

umask 077
printf '%s\n' "$SECRET" > "$SECRET_FILE"
logger -t aria2-secret "已生成 aria2 RPC 口令，见 $SECRET_FILE"

exit 0
