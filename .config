# ===== 目标机型：京东云太乙 ER1 (jdcloud_re-cs-07) =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y

# ===== Docker 全家桶（openwrt 官方源）=====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ===== 主题：vantage（第三方 feed，地址见 diy-part1.sh）=====
CONFIG_PACKAGE_luci-theme-vantage=y

# ===== 去广告 / DNS =====
# AdGuardHome（官方源）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
# mosdns（第三方 feed，地址见 diy-part1.sh）
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

# ===== SMB 文件共享（ksmbd，官方源）=====
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ===== 网盘聚合 alist（第三方 feed，地址见 diy-part1.sh）=====
CONFIG_PACKAGE_alist=y
CONFIG_PACKAGE_luci-app-alist=y

# ===== 代理 OpenClash（第三方 feed；首版先注释，基础固件跑通后再加）=====
# 加回：part1 追加 src-git openclash https://github.com/vernesong/OpenClash，再取消下一行注释
# CONFIG_PACKAGE_luci-app-openclash=y

# ===== LuCI Web 基础（必须显式选：luci-app-* 不会自动拉 uhttpd / luci-mod）=====
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# ===== 运维小工具（官方源，本体依赖编译自动拉取）=====
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-ttyd=y
# iStore 软件中心（第三方 feed istore；Lua 面板运行时 luci-lua-runtime；
# taskd/luci-lib-taskd/luci-lib-xterm 由依赖自动拉取；界面中文随主包内置，无独立 i18n 包）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lua-runtime=y
# Lua CBI 兼容层：老式 Lua CBI 面板（如第三方 zerotier 面板）依赖 luci.cbi，
# 该模块仅由 luci-compat 提供；新 luci 默认不带，缺它会报 module 'luci.cbi' not found。
CONFIG_PACKAGE_luci-compat=y

# ===== TUN 内核模块（与内核同树编译，提供 /dev/net/tun；zerotier/Passwall/WireGuard 等后期手动装的 VPN/组网都要用）=====
CONFIG_PACKAGE_kmod-tun=y
# zerotier 客户端本体与面板不预置进固件，后期在 iStore 软件中心或命令行 apk add zerotier 手动安装。

# ===== 中文界面（zh-cn）=====
# 真正生效的翻译开关：luci-base → Translations → 简体中文（内部语言代码 zh_Hans）。
# 打开后 luci.mk 会把所有已选主包对应的 luci-i18n-*-zh-cn 翻译包自动纳入。
# 注意：luci-i18n-* 是 HIDDEN 包，单独写 CONFIG_PACKAGE_luci-i18n-*-zh-cn=y
# 会被 make defconfig 按默认逻辑清掉，不能作为主开关，故这里只保留 LUCI_LANG 开关。
CONFIG_LUCI_LANG_zh_Hans=y

# ===== 基础常用 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_luci-app-ddns=y

