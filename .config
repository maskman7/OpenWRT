# ===== 目标机型：京东云太乙 ER1 (jdcloud_re-cs-07) =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y

# ===== Docker 全家桶（openwrt 官方源）=====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ===== 主题：vantage（第三方 feed，地址见 diy-part1.sh）=====
CONFIG_PACKAGE_luci-theme-vantage=y

# ===== 去广告 / DNS =====
# AdGuardHome（官方源）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
# mosdns（第三方 feed，地址见 diy-part1.sh）
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

# ===== SMB 文件共享（ksmbd，官方源）=====
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ===== 网盘聚合 alist（第三方 feed，地址见 diy-part1.sh）=====
CONFIG_PACKAGE_alist=y
CONFIG_PACKAGE_luci-app-alist=y

# ===== 代理 OpenClash（第三方 feed；首版先注释，基础固件跑通后再加）=====
# 加回：part1 追加 src-git openclash https://github.com/vernesong/OpenClash，再取消下一行注释
# CONFIG_PACKAGE_luci-app-openclash=y

# ===== LuCI Web 基础（必须显式选：luci-app-* 不会自动拉 uhttpd / luci-mod）=====
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# ===== 网络协议面板（LuCI 界面识别 dhcpv6 / PPPoE；底层 odhcp6c、ppp 已随系统默认拉入）=====
# wan6 协议为 dhcpv6，缺 luci-proto-ipv6 时接口页报"不支持的协议类型"
CONFIG_PACKAGE_luci-proto-ipv6=y
# 预留 PPPoE/PPtP 拨号界面（当前 wan 走 dhcp；ppp-mod-pppoe 本体已在系统内）
CONFIG_PACKAGE_luci-proto-ppp=y

# ===== 运维小工具（官方源，本体依赖编译自动拉取）=====
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-ttyd=y
# ===== 软件包管理：官方 luci-app-package-manager（已适配 apk，依赖 luci-base；自带 zh_Hans 翻译）=====
# 与 iStore 共存作为兜底；菜单位于 系统 → 软件包(Software)。
CONFIG_PACKAGE_luci-app-package-manager=y

# ===== Lua 兼容兜底（后期若装老式 Lua CBI 面板，如部分 zerotier 面板，需要这两个）=====
CONFIG_PACKAGE_luci-lua-runtime=y
# Lua CBI 兼容层：老式 Lua CBI 面板依赖 luci.cbi，仅由 luci-compat 提供；
# 新 luci 默认不带，缺它会报 module 'luci.cbi' not found。
CONFIG_PACKAGE_luci-compat=y

# 基础命令行工具（轻量；部分第三方脚本/服务可能调用）
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y

# ===== iStore 软件中心（第三方 feed，地址见 diy-part1.sh；B 方案）=====
# store 上游 LUCI_DEPENDS 写死 +tar（GNU tar）；part2 已 sed 去掉该依赖，改用 busybox tar
# （脚本仅用 -c/-czf/-zxf/-xz/-C，busybox 均支持），不再编入 GNU tar 本体。
# 用户态依赖 curl / libuci-lua / mount-utils / script-utils / coreutils / coreutils-stty 已在上方。
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y

# ===== TUN 内核模块（与内核同树编译，提供 /dev/net/tun；zerotier/Passwall/WireGuard 等 VPN/组网都要用）=====
CONFIG_PACKAGE_kmod-tun=y

# ===== ZeroTier 组网客户端（官方 packages feed，zerotier 1.16.x）=====
# 依赖 kmod-tun / ip / libstdcpp / libminiupnpc / libnatpmp / libatomic；
# 内核模块 kmod-tun 已在上方勾选，其余用户态库由编译自动拉取。
# 官方 luci feed 无面板；自适配 Lua 面板随 files/ 目录内置（VPN→ZeroTier 状态/设置），
# 适配官方 global/network config，依赖 luci-compat / luci-lua-runtime（已在上方勾选）。
CONFIG_PACKAGE_zerotier=y

# ===== 中文界面（zh-cn）=====
# 真正生效的翻译开关：luci-base → Translations → 简体中文（内部语言代码 zh_Hans）。
# 打开后 luci.mk 会把所有已选主包对应的 luci-i18n-*-zh-cn 翻译包自动纳入。
# 注意：luci-i18n-* 是 HIDDEN 包，单独写 CONFIG_PACKAGE_luci-i18n-*-zh-cn=y
# 会被 make defconfig 按默认逻辑清掉，不能作为主开关，故这里只保留 LUCI_LANG 开关。
CONFIG_LUCI_LANG_zh_Hans=y

# ===== USB 存储与挂载（外接 U 盘/移动硬盘；配合「系统→挂载点」与 KSMBD 共享）=====
# 必备三件：block-mount 提供 /sbin/block 与「挂载点」页数据源及自动挂载；
# kmod-usb-storage(+uas) 让内核识别 U 盘；kmod-fs-* 让内核读 FAT32/exFAT/NTFS。
# 缺 block-mount 时「系统→挂载点」菜单可能直接不显示；缺 usb-storage 时
# /proc/partitions 只有 mmcblk*，dmesg 仅见 usb 枚举、无 sd* 磁盘。
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 用户态工具：exfatprogs（mkfs/fsck exfat）、usbutils（lsusb 查设备）；e2fsprogs 已在 iStore 依赖段。
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_usbutils=y

# ===== 基础常用 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_luci-app-ddns=y

